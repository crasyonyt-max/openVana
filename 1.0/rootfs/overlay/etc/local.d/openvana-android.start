#!/bin/sh
# Android runtime (Waydroid) setup in TABLET mode.
# Runs in the background and keeps retrying, because the first `waydroid init`
# needs internet (unless the images are baked into the ISO). If Android gets
# initialised some other way (e.g. the Waydroid window), tablet mode is still applied.
(
CFG=/var/lib/waydroid/waydroid.cfg
for _ in $(seq 1 120); do
    if [ -e "$CFG" ]; then
        grep -q '^ro.build.characteristics = tablet' "$CFG" && exit 0
        # Tablet profile: apps read ro.build.characteristics and the smallest
        # screen width (>= 600dp at density 160) and load their tablet layouts.
        # multi_windows puts every Android app in its own desktop window.
        sed -i '/^\[properties\]/,$d' "$CFG"
        cat /etc/waydroid-extra/tablet.prop >> "$CFG"
        waydroid upgrade --offline
        rc-service waydroid-container restart
        exit 0
    fi
    # Uses /usr/share/waydroid-extra/images when present, otherwise downloads.
    waydroid init >/var/log/openvana-android.log 2>&1 || sleep 30
done
) &
