#!/bin/sh
# vana-apk — install / launch Android apps on openVana (via Waydroid).
#   vana-apk install <file.apk>   install an APK (also used when an .apk is opened)
#   vana-apk list                 list installed Android apps
set -eu

ensure_session() {
    waydroid status 2>/dev/null | grep -q 'Session:.*RUNNING' && return
    (waydroid session start >/dev/null 2>&1 &)
    i=0
    until waydroid status 2>/dev/null | grep -q 'Session:.*RUNNING'; do
        i=$((i + 1)); [ $i -gt 90 ] && { echo "Android runtime did not start" >&2; exit 1; }
        sleep 1
    done
    # wait until Android's package manager answers
    until waydroid app list >/dev/null 2>&1; do sleep 1; done
}

case "${1:-}" in
install)
    [ -f "${2:-}" ] || { echo "usage: vana-apk install <file.apk>" >&2; exit 2; }
    ensure_session
    waydroid app install "$2"
    ;;
list)
    ensure_session
    waydroid app list
    ;;
*)
    # Called as a file handler: "vana-apk <file.apk>"
    [ -f "${1:-}" ] && exec "$0" install "$1"
    echo "usage: vana-apk install <file.apk> | list" >&2; exit 2
    ;;
esac
