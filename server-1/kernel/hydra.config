# VanaKernel Hydra — the openVana Server kernel.
# Base: Debian's own amd64 kernel configuration (widest hardware support,
# tested by Debian), then these VanaKernel changes are merged on top.

# ---- identity ----
CONFIG_LOCALVERSION="-vanakernel-hydra"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="openvana-server"

# ---- security: no in-kernel SMB server (KSMBD) ----
# CONFIG_SMB_SERVER is not set

# ---- stability: no drivers from the kernel's "staging" (not yet stable) area,
# ---- and no TV/webcam/DVB media stack on a server
# CONFIG_STAGING is not set
# CONFIG_MEDIA_SUPPORT is not set

# ---- graphics: Debian's proven framebuffer console (efifb/vesafb) stays as is;
# ---- make sure the emulator GPUs are there (QEMU std VGA, Cirrus, e.g. Limbo)
CONFIG_DRM_BOCHS=m
CONFIG_DRM_CIRRUS_QEMU=m

# ---- Windows programs (Wine): 32-bit programs, binfmt for running .exe directly
CONFIG_IA32_EMULATION=y
CONFIG_BINFMT_MISC=m

# ---- lean build: no debug info (Debian ships it separately), zstd modules
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_BTF is not set
CONFIG_DEBUG_INFO_NONE=y
CONFIG_MODULE_COMPRESS_ZSTD=y

# ---- Debian's signing keys are not available outside Debian's build servers
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
