// openVana Server system info (run: fastfetch)
{
  "logo": {
    "type": "file",
    "source": "/usr/share/openvana/fastfetch-logo.txt",
    "color": { "1": "green", "2": "white", "3": "light_green" }
  },
  "display": { "color": { "keys": "light_green" } },
  "modules": [
    "title", "separator", "os", "host", "kernel", "uptime", "packages",
    "shell", "cpu", "memory", "swap", "disk", "localip", "break", "colors"
  ]
}
