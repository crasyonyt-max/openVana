# Installs Google Chrome once on an installed system. Started at boot and every
# 6 hours by openvana-chrome-firstboot.timer until it has succeeded; without
# internet it waits quietly for the next try instead of failing.
[Unit]
Description=Install Google Chrome (first start)
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/var/lib/openvana/chrome-installed
ConditionPathExists=!/run/live/medium

[Service]
Type=oneshot
ExecStart=/usr/sbin/vana-get-chrome --auto
StateDirectory=openvana
TimeoutStartSec=15min
